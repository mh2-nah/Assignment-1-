import java.util.Scanner;

public class Task05 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[11]; // Size 11 because we will insert one extra element
        
        // Input 10 numbers
        System.out.println("Enter 10 numbers:");
        for (int i = 0; i < 10; i++) {
            arr[i] = sc.nextInt();
        }

        // Input index and number to insert
        System.out.print("Enter index (0-10) to insert: ");
        int index = sc.nextInt(); // Position to insert
        System.out.print("Enter number to insert: ");
        int num = sc.nextInt(); // Number to insert

        // Shift elements to the right to make space
        for (int i = 10; i > index; i--) {
            arr[i] = arr[i - 1]; // Move each element one step right
        }
        arr[index] = num; // Insert new number at given index

        // Print updated array
        System.out.println("Updated array:");
        for (int i = 0; i < 11; i++) {
            System.out.print(arr[i] + " ");
        }
        sc.close();
    }
}

import java.util.Scanner;

public class Task06 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10]; // Array of size 10
        
        // Input 10 numbers
        System.out.println("Enter 10 numbers:");
        for (int i = 0; i < 10; i++) {
            arr[i] = sc.nextInt();
        }

        // Input index to delete
        System.out.print("Enter index to delete (0-9): ");
        int index = sc.nextInt(); // Index to remove

        // Shift elements to left to overwrite the deleted element
        for (int i = index; i < 9; i++) {
            arr[i] = arr[i + 1]; // Replace current with next element
        }

        // Print array after deletion (only 9 elements now)
        System.out.println("Updated array:");
        for (int i = 0; i < 9; i++) {
            System.out.print(arr[i] + " ");
        }
        sc.close();
    }
}

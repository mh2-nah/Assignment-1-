
import java.util.Scanner;

public class Task11 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] a1 = new int[5]; // First array
        int[] a2 = new int[5]; // Second array
        
        // Input first sorted array
        System.out.println("Enter 5 sorted numbers for first array:");
        for (int i = 0; i < 5; i++) {
            a1[i] = sc.nextInt();
        }
        
        // Input second sorted array
        System.out.println("Enter 5 sorted numbers for second array:");
        for (int i = 0; i < 5; i++) {
            a2[i] = sc.nextInt();
        }

        int[] merged = new int[10]; // Array to store merged result
        int i = 0, j = 0, k = 0; // i for a1, j for a2, k for merged

        // Merging Logic
        while (i < 5 && j < 5) { // Till one array ends
            if (a1[i] < a2[j]) { // Compare and take smaller
                merged[k++] = a1[i++]; // Store and increment pointers
            } else {
                merged[k++] = a2[j++];
            }
        }

        // Copy remaining elements of first array
        while (i < 5) {
            merged[k++] = a1[i++];
        }
        // Copy remaining elements of second array
        while (j < 5) {
            merged[k++] = a2[j++];
        }

        // Display merged sorted array
        System.out.println("Merged sorted array (without sorting):");
        for (int x = 0; x < 10; x++) {
            System.out.print(merged[x] + " ");
        }
        sc.close();
    }
}

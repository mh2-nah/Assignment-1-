import java.util.Scanner;

public class Task10 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] a1 = new int[5]; // First array
        int[] a2 = new int[5]; // Second array
        
        // Input first sorted array
        System.out.println("Enter 5 sorted numbers for first array:");
        for (int i = 0; i < 5; i++) {
            a1[i] = sc.nextInt();
        }
        
        // Input second sorted array
        System.out.println("Enter 5 sorted numbers for second array:");
        for (int i = 0; i < 5; i++) {
            a2[i] = sc.nextInt();
        }

        int[] merged = new int[10]; // Merged array of size 10
        int i = 0, j = 0, k = 0; // Pointers for a1, a2, merged

        // Merge two sorted arrays (without using extra sort)
        while (i < 5 && j < 5) {
            if (a1[i] < a2[j]) { // If element of a1 is smaller
                merged[k++] = a1[i++]; // Add to merged and move pointers
            } else {
                merged[k++] = a2[j++]; // Add element of a2
            }
        }

        // Add remaining elements of a1 if any left
        while (i < 5) {
            merged[k++] = a1[i++];
        }
        // Add remaining elements of a2 if any left
        while (j < 5) {
            merged[k++] = a2[j++];
        }

        // Print merged array
        System.out.println("Merged sorted array:");
        for (int x = 0; x < 10; x++) {
            System.out.print(merged[x] + " ");
        }

        // Find largest in merged array
        int largest = merged[0]; // Assume first is largest
        for (int x = 1; x < 10; x++) {
            if (merged[x] > largest) { // Compare
                largest = merged[x]; // Update largest
            }
        }
        System.out.println("\nLargest = " + largest);
        sc.close();
    }
}
